{
    "$schema": "https://schema.tauri.app/config/2",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../build",
        "devUrl": "http://localhost:1420"
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "publisher": "Olivier Bazin",
        "homepage": "https://github.com/obazin/janis",
        "license": "GPL-3.0-only",
        "licenseFile": "../LICENSE",
        "category": "Music",
        "shortDescription": "Open-source desktop audio player",
        "longDescription": "Local library with real metadata, curated web radio, a live 10-band equalizer and live waveform visualisation.",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "macOS": {
            "signingIdentity": "-",
            "minimumSystemVersion": "11.0"
        },
        "linux": {
            "deb": {
                "depends": ["libasound2"]
            },
            "rpm": {
                "depends": ["libasound.so.2()(64bit)"]
            }
        }
    },
    "productName": "Janis",
    "mainBinaryName": "Janis",
    "version": "0.1.0",
    "identifier": "com.olivierbazin.janis",
    "plugins": {},
    "app": {
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'none'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'"
        },
        "windows": [
            {
                "label": "main",
                "title": "Janis",
                "width": 1280,
                "height": 800,
                "minWidth": 1024,
                "minHeight": 680,
                "resizable": true,
                "titleBarStyle": "Overlay",
                "hiddenTitle": true,
                "backgroundColor": "#0C0714"
            }
        ]
    }
}
