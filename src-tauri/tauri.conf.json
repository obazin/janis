{
    "$schema": "https://schema.tauri.app/config/2",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../build",
        "devUrl": "http://localhost:1420"
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    },
    "productName": "Janis",
    "mainBinaryName": "Janis",
    "version": "0.1.0",
    "identifier": "com.olivierbazin.janis",
    "plugins": {},
    "app": {
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self'; media-src 'self' asset: http://asset.localhost blob: https: http:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'",
            "assetProtocol": {
                "enable": true,
                "scope": []
            }
        },
        "windows": [
            {
                "label": "main",
                "title": "Janis",
                "width": 1280,
                "height": 800,
                "minWidth": 1024,
                "minHeight": 680,
                "resizable": true,
                "titleBarStyle": "Overlay",
                "hiddenTitle": true,
                "backgroundColor": "#0C0714"
            }
        ]
    }
}
