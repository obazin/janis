import { Tokens, Motion } from "../tokens.slint";

// A switch whose knob slides.
export component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    callback toggled();

    width: 46px;
    height: 26px;
    border-radius: self.height / 2;
    background: root.checked ? Tokens.accent : Tokens.rail;
    animate background { duration: Motion.base; }
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(); }

    Rectangle {
        x: root.checked ? 23px : 3px;
        y: 3px;
        width: 20px;
        height: 20px;
        border-radius: self.width / 2;
        background: Tokens.text;
        animate x { duration: Motion.base; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}
