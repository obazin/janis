import { Tokens, Typography, Accent } from "../tokens.slint";

export enum BadgeVariant { outline, soft, tint }

// A small pill: outlined and uppercase, softly filled, or tinted with an accent.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <BadgeVariant> variant: BadgeVariant.soft;
    in property <Accent> tone: Accent.lime;

    property <bool> outline: root.variant == BadgeVariant.outline;
    property <color> tint: Tokens.accent-color(root.tone);

    width: self.preferred-width;
    height: self.preferred-height;
    border-radius: self.height / 2;
    border-width: root.outline ? 1px : 0px;
    border-color: Tokens.border-emphasis;
    background: root.outline ? transparent : root.variant == BadgeVariant.tint ? root.tint.with-alpha(0.12) : Tokens.chip;

    HorizontalLayout {
        padding-left: root.outline ? 7px : 12px;
        padding-right: self.padding-left;
        padding-top: root.outline ? 2px : 6px;
        padding-bottom: self.padding-top;
        Text {
            text: root.outline ? root.text.to-uppercase() : root.text;
            font-size: root.outline ? Typography.label : Typography.caption;
            font-weight: Typography.semibold;
            letter-spacing: root.outline ? Typography.tracking-pill * Typography.label : 0px;
            color: root.outline ? Tokens.text-muted : root.variant == BadgeVariant.tint ? root.tint : Tokens.text-secondary;
        }
    }
}
