import { Tokens, Typography, Metrics, Motion } from "../../tokens.slint";
import { Strings } from "strings.slint";
import { Icons } from "../../icons.slint";
import { ArtTile } from "../../atoms/art_tile.slint";
import { Glyph, GlyphMode } from "../../atoms/glyph.slint";
import { StationRow } from "radio.slint";

// A station: its tile, name, genre and bit rate, a star when it is a
// favourite — and, once it is the one loaded, whether it is connecting or live.
export component StationCard inherits Rectangle {
    in property <StationRow> station;
    in property <bool> active;
    in property <bool> connecting;
    callback clicked();

    property <color> status: root.connecting ? Tokens.text-muted : Tokens.live;

    border-radius: Metrics.radius-card;
    border-width: 1px;
    border-color: root.active ? Tokens.station-active-outline : Tokens.border;
    background: touch.has-hover ? Tokens.panel-hover : Tokens.panel;
    animate background { duration: Motion.base; }
    accessible-role: button;
    accessible-label: root.station.name;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding: 14px;
        spacing: 14px;
        ArtTile {
            width: 54px;
            height: 54px;
            radius: 12px;
            gradient-index: root.station.gradient-index;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            HorizontalLayout {
                alignment: start;
                spacing: 6px;
                Text {
                    text: root.station.name;
                    font-size: Typography.heading-sm;
                    font-weight: Typography.bold;
                    color: Tokens.text;
                    horizontal-alignment: left;
                    overflow: elide;
                }
                // The line's box leaves room under the baseline; the padding
                // brings the star down to the middle of the capitals.
                if root.station.favourite: VerticalLayout {
                    alignment: center;
                    padding-top: 3px;
                    Glyph {
                        width: 13px;
                        height: 13px;
                        icon: Icons.star;
                        mode: GlyphMode.fill;
                        tint: Tokens.accent;
                        accessible-role: text;
                        accessible-label: Strings.radio-favourite;
                    }
                }
            }
            Text {
                text: root.station.detail;
                font-size: Typography.caption;
                color: Tokens.text-muted;
                horizontal-alignment: left;
                overflow: elide;
            }
        }
        if root.active: HorizontalLayout {
            spacing: 5px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: self.width / 2;
                    background: root.status;
                    drop-shadow-blur: root.connecting ? 0px : 8px;
                    drop-shadow-color: root.connecting ? transparent : Tokens.live;
                }
            }
            Text {
                text: (root.connecting ? Strings.radio-connecting : Strings.radio-live).to-uppercase();
                font-size: Typography.label;
                font-weight: Typography.bold;
                color: root.status;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
