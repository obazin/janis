// The web-radio catalog as the Radio screen shows it. Filled by the
// application; the callbacks are the listener's actions.

// A country or genre filter chip.
export struct RadioChip {
    key: string,
    label: string,
    active: bool,
}

export struct StationRow {
    id: string,
    name: string,
    // Genre and bit rate.
    detail: string,
    // The listener starred it.
    favourite: bool,
    gradient-index: int,
}

export global Radio {
    // The "all" chip first, then one per country or genre.
    in property <[RadioChip]> countries;
    in property <[RadioChip]> genres;
    // The stations the filters and the search kept.
    in property <[StationRow]> stations;
    // The station loaded in the player; empty when none is.
    in property <string> active-station-id;
    // True while that station is still connecting.
    in property <bool> connecting;
    // The loaded station is one the listener starred.
    in property <bool> active-station-favourite;
    // Only the starred stations are listed.
    in property <bool> favourites-only;

    callback country-toggled(key: string);
    callback genre-toggled(key: string);
    callback favourites-toggled();
    // Stars the loaded station, or takes its star away.
    callback active-station-favourite-toggled();
    callback station-clicked(index: int);
}
