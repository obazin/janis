import { Tokens, Typography, Metrics } from "../../tokens.slint";
import { Icons } from "../../icons.slint";
import { Strings } from "strings.slint";
import { GhostButton } from "../../atoms/ghost_button.slint";
import { IconButton, IconButtonIdentifier } from "../../atoms/icon_button.slint";
import { SectionLabel } from "../../atoms/section_label.slint";
import { Dialog } from "../../molecules/dialog.slint";
import { ScrollArea } from "../../molecules/scroll_area.slint";
import { CoverArt } from "cover_art.slint";
import { Library, ManagedPlaylist, ManagedRow, ManagedRowKind } from "library.slint";

// A playlist of the sheet: its cover, its name, the group it is in, and
// what can be done to it.
component ManagedPlaylistRow inherits Rectangle {
    in property <ManagedPlaylist> playlist;

    height: 58px;
    border-radius: Metrics.radius-inset;
    background: Tokens.panel;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            CoverArt {
                width: 40px;
                height: 40px;
                radius: Metrics.radius-tile;
                playlist-id: root.playlist.playlist-id;
                track-id: root.playlist.track-id;
                gradient-index: root.playlist.gradient-index;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.playlist.name;
                font-size: Typography.body-em;
                font-weight: Typography.semibold;
                color: Tokens.text;
                horizontal-alignment: left;
                overflow: elide;
            }
            Text {
                text: root.playlist.detail;
                font-size: Typography.caption;
                color: Tokens.text-muted;
                horizontal-alignment: left;
                overflow: elide;
            }
        }
        HorizontalLayout {
            width: 200px;
            alignment: start;
            GhostButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.folder;
                label: root.playlist.group;
                clicked => {
                    Library.group-menu-requested(root.playlist.playlist-id, self.absolute-position.x, self.absolute-position.y + self.height + 4px);
                }
            }
        }
        HorizontalLayout {
            // As wide with or without a picture to remove, so the rows line up.
            width: 4 * 20px + 3 * 12px;
            alignment: end;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                IconButton {
                    identifier: IconButtonIdentifier.playlist-picture;
                    icon: Icons.image;
                    label: Strings.playlists-manage-picture;
                    clicked => { Library.playlist-picture-chosen(root.playlist.playlist-id); }
                }
            }
            if root.playlist.picture: VerticalLayout {
                alignment: center;
                IconButton {
                    identifier: IconButtonIdentifier.playlist-picture-remove;
                    icon: Icons.image-off;
                    label: Strings.playlists-manage-picture-remove;
                    clicked => { Library.playlist-picture-removed(root.playlist.playlist-id); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    identifier: IconButtonIdentifier.playlist-rename;
                    icon: Icons.pencil;
                    label: Strings.playlists-manage-rename;
                    clicked => { Library.playlist-renamed(root.playlist.playlist-id); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    identifier: IconButtonIdentifier.playlist-delete;
                    icon: Icons.trash;
                    label: Strings.playlists-manage-delete;
                    clicked => { Library.playlist-deleted(root.playlist.playlist-id); }
                }
            }
        }
    }
}

// A group's heading, at the foot of its row: its name and, for a group of
// the listener's, what can be done to it.
component ManagedHeading inherits Rectangle {
    in property <ManagedRow> entry;

    HorizontalLayout {
        y: parent.height - self.height - 4px;
        height: 26px;
        spacing: 12px;
        SectionLabel {
            horizontal-stretch: 1;
            label: root.entry.group-name;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.entry.group-id > 0: HorizontalLayout {
            spacing: 12px;
            padding-right: 12px;
            VerticalLayout {
                alignment: center;
                IconButton {
                    identifier: IconButtonIdentifier.playlist-group-rename;
                    icon: Icons.pencil;
                    label: Strings.playlists-manage-group-rename;
                    clicked => { Library.group-renamed(root.entry.group-id); }
                }
            }
            if !root.entry.first: VerticalLayout {
                alignment: center;
                IconButton {
                    identifier: IconButtonIdentifier.playlist-group-earlier;
                    icon: Icons.arrow-up;
                    label: Strings.playlists-manage-group-earlier;
                    clicked => { Library.group-moved(root.entry.group-id, true); }
                }
            }
            if !root.entry.last: VerticalLayout {
                alignment: center;
                IconButton {
                    identifier: IconButtonIdentifier.playlist-group-later;
                    icon: Icons.arrow-down;
                    label: Strings.playlists-manage-group-later;
                    clicked => { Library.group-moved(root.entry.group-id, false); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    identifier: IconButtonIdentifier.playlist-group-delete;
                    icon: Icons.trash;
                    label: Strings.playlists-manage-group-delete;
                    clicked => { Library.group-deleted(root.entry.group-id); }
                }
            }
        }
    }
}

// One row of the sheet, whichever kind it is.
component ManagedRowView inherits Rectangle {
    in property <ManagedRow> entry;

    if root.entry.kind == ManagedRowKind.heading: ManagedHeading {
        entry: root.entry;
    }
    // Where the playlists of an empty group would be: a row's outline,
    // saying how to file one there.
    if root.entry.kind == ManagedRowKind.empty: Rectangle {
        border-radius: Metrics.radius-inset;
        border-width: 1px;
        border-color: Tokens.border;
        Text {
            x: 16px;
            width: parent.width - 32px;
            text: Strings.playlists-manage-empty-group;
            font-size: Typography.body;
            color: Tokens.text-faint;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if root.entry.kind == ManagedRowKind.playlist: ManagedPlaylistRow {
        playlist: root.entry.playlist;
    }
}

// The sheet that sorts the playlists into groups — made, named, ordered
// and removed here — and gives them pictures, names, or the door.
export component PlaylistManager inherits Dialog {
    title: Strings.playlists-manage-title;
    confirm-label: Strings.playlists-manage-done;
    sheet-width: 760px;
    confirmed => { Library.manager-closed(); }
    cancelled => { Library.manager-closed(); }

    HorizontalLayout {
        alignment: start;
        GhostButton {
            icon: Icons.plus;
            label: Strings.playlists-manage-new-group;
            clicked => { Library.group-added(); }
        }
    }

    list := ScrollArea {
        // Every row is as tall as a playlist's: a heading sits at the foot of
        // its row, so the space above it parts it from the group before, and
        // the first heading's is cut off the top.
        property <length> row-height: 58px;
        property <length> pitch: self.row-height + 8px;
        property <length> lead: 28px;
        property <length> rows-height: max(0px, Library.managed-rows.length * self.pitch - self.lead - 8px);
        property <int> first: max(0, floor((self.scroll-offset + self.lead) / self.pitch));
        property <int> count: max(0, min(ceil(self.height / self.pitch) + 1, Library.managed-rows.length - self.first));

        // The sheet leaves room for its title and buttons.
        height: max(0px, min(self.rows-height, root.height - 260px));
        content-height: self.rows-height;

        for offset in list.count: ManagedRowView {
            property <int> index: list.first + offset;
            x: 0;
            y: self.index * list.pitch - list.lead;
            width: list.content-width;
            height: list.row-height;
            entry: Library.managed-rows[self.index];
        }
    }
}
