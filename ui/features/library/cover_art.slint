import { ArtTile } from "../../atoms/art_tile.slint";
import { Covers } from "covers.slint";

// An art tile that shows a library track's cover — or a playlist's, when
// given a `playlist-id` — loading it when the tile first appears. A
// `track-id` of 0 stays a gradient.
export component CoverArt inherits ArtTile {
    in property <int> track-id;
    in property <int> playlist-id;

    cover: root.playlist-id > 0 ? Covers.playlist-cover(root.playlist-id, Covers.revision) : Covers.thumbnail(root.track-id, Covers.revision);
    unavailable: Covers.unavailable(root.track-id, Covers.revision);
}
