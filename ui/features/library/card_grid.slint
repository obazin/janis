import { Motion } from "../../tokens.slint";
import { Library, LibraryCard } from "library.slint";
import { Covers, CoverList } from "covers.slint";
import { AlbumCard } from "album_card.slint";
import { LibraryTrackAccordion } from "library_track_accordion.slint";

// The album or artist grid: as many cards per row as fit, and — under the row
// of the selected card — its tracks, in place. Only the lines in view are
// drawn, so a library of thousands of albums asks for no more covers than
// the screen shows.
//
// Opening a card under the line of an open one takes two movements: the open
// panel folds while the page brings the card's line to the top, then the
// card's panel unfolds beneath it. Anywhere else, it is one movement.
export component CardGrid inherits Rectangle {
    in property <[LibraryCard]> cards;
    in property <bool> shows-detail;
    // Where the visible window starts, measured from the top of the grid.
    in property <length> view-top;
    in property <length> view-height;
    // Which list the cards are, as told to `Covers.in-view`; `none` reports
    // nothing.
    in property <CoverList> cover-list;
    callback card-clicked(index: int);
    // A card was opened: the page brings `line-top`, where its line starts
    // once the panel open before has folded, to the top. `settled-height` is
    // the grid's height once every panel has finished moving.
    callback opened(line-top: length, settled-height: length);

    property <length> gap: 20px;
    property <length> narrowest-card: 180px;
    property <int> columns: max(1, floor((root.width + root.gap) / (root.narrowest-card + root.gap)));
    // Never narrower than the narrowest card: before the first layout the grid
    // has no width yet, and a card of no width would make every line a few
    // pixels tall and put hundreds of lines in view.
    property <length> card-width: max(root.narrowest-card, (root.width - (root.columns - 1) * root.gap) / root.columns);
    property <length> card-height: root.card-width + (root.shows-detail ? 70px : 52px);
    property <length> line-height: root.card-height + root.gap;
    property <int> line-count: ceil(root.cards.length / root.columns);

    // The line holding the selected card, or -1 when none of these is selected.
    property <int> selected-line: Library.selection-index >= 0 ? floor(Library.selection-index / root.columns) : -1;

    // How far each panel is open, from 0 to 1. A panel opened by a click
    // starts closed; one found open when the screen is built is open.
    property <float> unfolded: 1;
    property <float> folded-open: 0;
    property <bool> moving-instantly;
    property <bool> unfolds-after-folding;
    animate unfolded {
        duration: root.moving-instantly ? 0ms : Motion.glide;
        delay: root.moving-instantly || !root.unfolds-after-folding ? 0ms : Motion.glide;
        easing: ease-out;
    }
    animate folded-open {
        duration: root.moving-instantly ? 0ms : Motion.glide;
        easing: ease-out;
    }

    // The line whose panel the last click put away, or -1.
    property <int> folding-line: Library.folding-index >= 0 ? floor(Library.folding-index / root.columns) : -1;

    property <length> accordion-room: root.selected-line >= 0 ? (accordion.height + root.gap) * root.unfolded : 0px;
    property <length> folding-room: root.folding-line >= 0 ? (folding.height + root.gap) * root.folded-open : 0px;

    // Where each panel starts, counting the other when it lies above. Two
    // panels under the same line stack, the folding one first.
    property <length> accordion-top: (root.selected-line + 1) * root.line-height + (root.folding-line >= 0 && root.folding-line <= root.selected-line ? root.folding-room : 0px);
    property <length> folding-top: (root.folding-line + 1) * root.line-height + (root.selected-line >= 0 && root.selected-line < root.folding-line ? root.accordion-room : 0px);

    // The first line in view: the window's top with the panels above it
    // taken out. A window starting inside a panel draws the line above it,
    // which costs nothing.
    property <length> lines-top: root.view-top - max(0px, min(root.accordion-room, root.view-top - root.accordion-top)) - max(0px, min(root.folding-room, root.view-top - root.folding-top));
    property <int> first-line: max(0, floor(root.lines-top / root.line-height));
    property <int> line-span: ceil(root.view-height / root.line-height) + 1;

    // The cards drawn, told to the controller so it loads the covers beyond.
    property <int> shown-first: root.first-line * root.columns;
    property <int> shown-count: root.line-span * root.columns;
    function report-shown() {
        if root.cover-list != CoverList.none {
            Covers.in-view(root.cover-list, root.shown-first, root.shown-count);
        }
    }
    init => { root.report-shown(); }
    changed shown-first => { root.report-shown(); }
    changed shown-count => { root.report-shown(); }
    changed cover-list => { root.report-shown(); }

    // Only a panel folding above the opened card's line moves that line, so
    // only then does the new panel wait for the fold; under the same line or
    // further down, both move at once.
    property <int> selection-changes: Library.selection-changes;
    changed selection-changes => {
        let folds = root.folding-line >= 0;
        root.moving-instantly = true;
        root.folded-open = folds ? 1 : 0;
        root.unfolded = 0;
        root.moving-instantly = false;
        root.unfolds-after-folding = folds && root.selected-line >= 0 && root.folding-line < root.selected-line;
        root.folded-open = 0;
        if root.selected-line >= 0 {
            root.unfolded = 1;
            root.opened(root.selected-line * root.line-height, root.line-count * root.line-height + accordion.height + root.gap);
        }
    }

    height: root.line-count * root.line-height + root.accordion-room + root.folding-room;

    for offset in root.line-span * root.columns: AlbumCard {
        property <int> index: root.first-line * root.columns + offset;
        property <int> line: floor(self.index / root.columns);
        x: mod(self.index, root.columns) * (root.card-width + root.gap);
        y: self.line * root.line-height + (root.selected-line >= 0 && self.line > root.selected-line ? root.accordion-room : 0px) + (root.folding-line >= 0 && self.line > root.folding-line ? root.folding-room : 0px);
        width: root.card-width;
        height: root.card-height;
        visible: self.index < root.cards.length;
        card: root.cards[self.index];
        active: self.index == Library.selection-index;
        shows-detail: root.shows-detail;
        clicked => { root.card-clicked(self.index); }
    }

    // The panel put away, still showing what it held while it folds.
    Rectangle {
        y: root.folding-top;
        height: folding.height * root.folded-open;
        visible: root.folding-line >= 0 && root.folded-open > 0;
        clip: true;
        folding := LibraryTrackAccordion {
            y: 0;
            heading: Library.folding-heading;
            tracks: Library.folding-tracks;
            view-top: root.view-top - root.folding-top;
            view-height: root.view-height;
        }
    }

    Rectangle {
        y: root.accordion-top;
        height: accordion.height * root.unfolded;
        visible: root.selected-line >= 0 && root.unfolded > 0;
        clip: true;
        accordion := LibraryTrackAccordion {
            y: 0;
            heading: Library.selection-heading;
            tracks: Library.selection-tracks;
            view-top: root.view-top - root.accordion-top;
            view-height: root.view-height;
            track-clicked(index) => { Library.selection-track-clicked(index); }
            closed => { Library.selection-closed(); }
        }
    }
}
