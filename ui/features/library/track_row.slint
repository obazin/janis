import { Tokens, Fonts, Typography, Motion, Metrics } from "../../tokens.slint";
import { Icons } from "../../icons.slint";
import { Strings } from "strings.slint";
import { GlyphMode } from "../../atoms/glyph.slint";
import { IconButton, IconButtonIdentifier, IconButtonTone } from "../../atoms/icon_button.slint";
import { CoverArt } from "cover_art.slint";
import { Library, LibraryTrack } from "library.slint";

// A row of a library track list: number, cover, title and artist, composer,
// the star that makes it a favourite, duration. A right-click opens the
// song's menu.
export component TrackRow inherits Rectangle {
    in property <LibraryTrack> track;
    // Every row but the first is ruled off from the one above.
    in property <bool> ruled;
    // The row is in a playlist's panel: its menu offers to take it out.
    in property <bool> in-playlist;
    callback clicked();

    background: touch.has-hover ? Tokens.row-hover : transparent;
    animate background { duration: Motion.fast; }
    accessible-role: button;
    accessible-label: root.track.title;
    accessible-action-default => { root.clicked(); }

    if root.ruled: Rectangle {
        y: 0;
        height: 1px;
        background: Tokens.divider;
    }

    // The row's contents sit inside its touch area: the star takes its own
    // clicks, and the row keeps its hover while the pointer is on the star.
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                Library.track-menu-requested(root.track.track-id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, root.in-playlist);
            }
        }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 16px;
            Text {
                width: 26px;
                text: root.track.number;
                font-family: Fonts.mono;
                font-size: Typography.body;
                color: Tokens.text-faint;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                CoverArt {
                    width: 38px;
                    height: 38px;
                    radius: Metrics.radius-tile;
                    track-id: root.track.track-id;
                    gradient-index: root.track.gradient-index;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: root.track.title;
                    font-size: Typography.body-em;
                    font-weight: Typography.semibold;
                    color: Tokens.text;
                    horizontal-alignment: left;
                    overflow: elide;
                }
                Text {
                    text: root.track.artist;
                    font-size: Typography.caption;
                    color: Tokens.text-muted;
                    horizontal-alignment: left;
                    overflow: elide;
                }
            }
            Text {
                width: 140px;
                text: root.track.composer;
                font-size: Typography.body;
                color: Tokens.text-muted;
                horizontal-alignment: left;
                vertical-alignment: center;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    identifier: IconButtonIdentifier.track-favourite;
                    icon: Icons.star;
                    label: root.track.favourite ? Strings.library-favourite-remove : Strings.library-favourite-add;
                    mode: root.track.favourite ? GlyphMode.fill : GlyphMode.stroke;
                    tone: IconButtonTone.muted;
                    active: root.track.favourite;
                    clicked => { Library.favourite-toggled(root.track.track-id); }
                }
            }
            Text {
                width: 70px;
                text: root.track.duration;
                font-family: Fonts.mono;
                font-size: Typography.caption;
                color: Tokens.text-muted;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}
