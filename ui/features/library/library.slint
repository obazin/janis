// The track library as the library screens show it. Filled by the
// application; the callbacks are the listener's actions.

// A card of the album and artist grids.
export struct LibraryCard {
    key: string,
    title: string,
    subtitle: string,
    detail: string,
    // The track whose cover stands for the card.
    track-id: int,
    gradient-index: int,
}

// A row of a track list.
export struct LibraryTrack {
    track-id: int,
    // The row's number, zero-padded.
    number: string,
    title: string,
    artist: string,
    composer: string,
    format: string,
    duration: string,
    gradient-index: int,
}

// A watched folder, as the Local Files screen lists it.
export struct WatchedFolderRow {
    id: int,
    path: string,
    track-count: string,
}

export global Library {
    // True when the library holds no track at all.
    in property <bool> empty: true;
    // The open tab: playlists, artists, albums or songs.
    in property <string> tab: "albums";

    // What the search kept.
    in property <[LibraryCard]> albums;
    in property <[LibraryCard]> artists;
    in property <[LibraryTrack]> songs;
    in property <[LibraryTrack]> recent;

    // The album or artist browsed in place: its place among the cards of the
    // open tab, or -1 when nothing is selected or the search hides it.
    in property <int> selection-index: -1;
    // True while an album or artist is selected, shown or not.
    in property <bool> selection-present;
    in property <string> selection-heading;
    in property <[LibraryTrack]> selection-tracks;
    // The panel the listener's last click put away, so it can fold with its
    // tracks still in it: its card's place, or -1 when none shows.
    in property <int> folding-index: -1;
    in property <string> folding-heading;
    in property <[LibraryTrack]> folding-tracks;
    // Counts the times the listener opened, switched or closed a selection:
    // the grid animates on these, and only these.
    in property <int> selection-changes;

    // ── Local Files ───────────────────────────────────────────────────────
    // The files the search kept there: it reads titles and artists only.
    in property <[LibraryTrack]> local-tracks;
    in property <string> scanned-heading;
    // What the last scan did; empty before the first one.
    in property <string> scan-report;
    in property <[WatchedFolderRow]> folders;

    callback local-track-clicked(index: int);
    callback rescan();
    callback folder-removed(id: int);

    // ── Discover ──────────────────────────────────────────────────────────
    in property <[LibraryCard]> discover-recent;
    in property <[LibraryCard]> discover-rediscover;
    in property <[LibraryCard]> discover-artists;

    // A tile of the recent, rediscover or artists shelf: play what it holds.
    callback shelf-tile-clicked(shelf: string, index: int);

    callback tab-selected(tab: string);
    callback album-clicked(index: int);
    callback artist-clicked(index: int);
    callback song-clicked(index: int);
    callback recent-clicked(index: int);
    callback selection-track-clicked(index: int);
    callback selection-closed();
    // Pick audio files to add.
    callback add-music();
    // Pick a folder to watch.
    callback add-folder();
}
