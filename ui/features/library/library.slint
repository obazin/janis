// The track library as the library screens show it. Filled by the
// application; the callbacks are the listener's actions.

// A card of the album and artist grids.
export struct LibraryCard {
    key: string,
    title: string,
    subtitle: string,
    detail: string,
    // The track whose cover stands for the card.
    track-id: int,
    gradient-index: int,
    // The playlist the card stands for, whose own cover it shows; 0 for an
    // album or an artist.
    playlist-id: int,
}

// One heading of the Playlists tab: a group's playlists, or those in none.
export struct PlaylistSection {
    // Empty for the playlists in no group when there is no group at all.
    heading: string,
    cards: [LibraryCard],
    // The open playlist's place among these cards, or -1.
    selection-index: int,
    // The place of the playlist whose panel is folding away, or -1.
    folding-index: int,
}

// A line of a menu that offers a choice: a playlist to add a song to, or a
// group to file a playlist in. `current` marks the playlist that holds the
// song already, or the group the playlist is in.
export struct MenuChoice {
    label: string,
    current: bool,
}

// A playlist in the sheet that manages them.
export struct ManagedPlaylist {
    playlist-id: int,
    name: string,
    detail: string,
    // The group it is in, as its button says.
    group: string,
    // The listener chose a picture for it.
    picture: bool,
    track-id: int,
    gradient-index: int,
}

// What a row of the sheet that manages the playlists is.
export enum ManagedRowKind {
    // A group's heading, with what can be done to the group.
    heading,
    // Under a heading, the line saying the group holds no playlist.
    empty,
    // A playlist of the group above.
    playlist,
}

// A row of the sheet that manages the playlists, its groups flattened in
// order: each group's heading, then its playlists or the line saying it has
// none. A group with an id of 0 holds the playlists in none.
export struct ManagedRow {
    kind: ManagedRowKind,
    // The group the row is in, and, on a heading, where it sits among them.
    group-id: int,
    group-name: string,
    first: bool,
    last: bool,
    // On a playlist row.
    playlist: ManagedPlaylist,
}

// A row of a track list.
export struct LibraryTrack {
    track-id: int,
    // The row's number, zero-padded.
    number: string,
    title: string,
    artist: string,
    composer: string,
    format: string,
    duration: string,
    gradient-index: int,
    // The listener starred it.
    favourite: bool,
}

// A watched folder, as the Local Files screen lists it.
export struct WatchedFolderRow {
    id: int,
    path: string,
    track-count: string,
}

export global Library {
    // True when the library holds no track at all.
    in property <bool> empty: true;
    // The open tab: playlists, artists, albums, songs or favourites.
    in property <string> tab: "albums";

    // What the search kept.
    in property <[LibraryCard]> albums;
    in property <[LibraryCard]> artists;
    in property <[LibraryTrack]> songs;
    in property <[LibraryTrack]> recent;
    in property <[LibraryTrack]> favourites;
    // True when no song is starred at all, whatever the search keeps.
    in property <bool> favourites-empty: true;

    // The album or artist browsed in place: its place among the cards of the
    // open tab, or -1 when nothing is selected or the search hides it.
    in property <int> selection-index: -1;
    // True while an album or artist is selected, shown or not.
    in property <bool> selection-present;
    in property <string> selection-heading;
    in property <[LibraryTrack]> selection-tracks;
    // The panel the listener's last click put away, so it can fold with its
    // tracks still in it: its card's place, or -1 when none shows.
    in property <int> folding-index: -1;
    in property <string> folding-heading;
    in property <[LibraryTrack]> folding-tracks;
    // Counts the times the listener opened, switched or closed a selection:
    // the grid animates on these, and only these.
    in property <int> selection-changes;

    // ── Playlists ─────────────────────────────────────────────────────────
    in property <[PlaylistSection]> playlist-sections;
    // True when there is no playlist at all, whatever the search keeps.
    in property <bool> playlists-empty: true;
    // True while the open selection is a playlist: its rows can leave it.
    in property <bool> selection-is-playlist;

    // The menu a right-click on a song opens, where the window was clicked.
    in property <bool> menu-open;
    in property <length> menu-x;
    in property <length> menu-y;
    // The playlists the song can go in, and whether each holds it already.
    in property <[MenuChoice]> menu-playlists;
    // The song is a favourite.
    in property <bool> menu-favourite;
    // The song was clicked in a playlist's panel.
    in property <bool> menu-in-playlist;
    // Opens with the playlists unfolded.
    in property <bool> menu-submenu-open;

    // The dialog that names a new playlist or group, or renames one.
    in property <bool> naming-open;
    in property <string> naming-title;
    in property <string> naming-label;
    in property <string> naming-confirm;
    in property <string> naming-text;

    // The dialog that asks before something is deleted.
    in property <bool> confirming-open;
    in property <string> confirming-title;
    in property <string> confirming-message;
    in property <string> confirming-confirm;

    // The sheet that groups the playlists and gives them pictures.
    in property <bool> manager-open;
    in property <[ManagedRow]> managed-rows;
    // The menu that files a playlist in a group, where the window was clicked.
    in property <bool> group-menu-open;
    in property <length> group-menu-x;
    in property <length> group-menu-y;
    // "No group" first, then each group.
    in property <[MenuChoice]> group-menu-choices;

    // A playlist's card was clicked: open it, or close it when it is open.
    callback playlist-clicked(section: int, index: int);
    // A song was right-clicked at `x`, `y` in the window; `in-playlist` when
    // its row is in a playlist's panel.
    callback track-menu-requested(track-id: int, x: length, y: length, in-playlist: bool);
    callback menu-closed();
    callback menu-playlist-chosen(index: int);
    callback menu-new-playlist();
    callback menu-favourite-toggled();
    callback menu-remove-from-playlist();
    callback naming-confirmed(name: string);
    callback naming-cancelled();
    callback confirming-confirmed();
    callback confirming-cancelled();
    callback manager-opened();
    callback manager-closed();
    callback group-added();
    callback group-renamed(group-id: int);
    callback group-moved(group-id: int, earlier: bool);
    callback group-deleted(group-id: int);
    callback playlist-renamed(playlist-id: int);
    callback playlist-deleted(playlist-id: int);
    callback playlist-picture-chosen(playlist-id: int);
    callback playlist-picture-removed(playlist-id: int);
    callback group-menu-requested(playlist-id: int, x: length, y: length);
    // A place among `group-menu-choices`, or -1 for a new group.
    callback group-menu-chosen(index: int);
    callback group-menu-closed();

    // ── Local Files ───────────────────────────────────────────────────────
    // The files the search kept there: it reads titles and artists only.
    in property <[LibraryTrack]> local-tracks;
    in property <string> scanned-heading;
    // What the last scan did; empty before the first one.
    in property <string> scan-report;
    in property <[WatchedFolderRow]> folders;

    callback local-track-clicked(index: int);
    callback rescan();
    callback folder-removed(id: int);

    // ── Discover ──────────────────────────────────────────────────────────
    in property <[LibraryCard]> discover-recent;
    in property <[LibraryCard]> discover-rediscover;
    in property <[LibraryCard]> discover-artists;

    // A tile of the recent, rediscover or artists shelf: play what it holds.
    callback shelf-tile-clicked(shelf: string, index: int);

    callback tab-selected(tab: string);
    callback album-clicked(index: int);
    callback artist-clicked(index: int);
    callback song-clicked(index: int);
    callback recent-clicked(index: int);
    callback favourite-clicked(index: int);
    // Stars the song of a row, or takes its star away.
    callback favourite-toggled(track-id: int);
    callback selection-track-clicked(index: int);
    callback selection-closed();
    // Pick audio files to add.
    callback add-music();
    // Pick a folder to watch.
    callback add-folder();
}
