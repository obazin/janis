import { Tokens, Typography, Metrics, Motion } from "../../tokens.slint";
import { CoverArt } from "cover_art.slint";
import { LibraryCard } from "library.slint";

// A card of the album and artist grids: the cover, a title and a line or two
// under it. The selected card wears the accent outline.
export component AlbumCard inherits Rectangle {
    in property <LibraryCard> card;
    in property <bool> active;
    in property <bool> shows-detail;
    callback clicked();

    property <length> inset: 14px;

    accessible-role: button;
    accessible-label: root.card.title;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        // The card lifts a little under the pointer.
        y: touch.has-hover ? -3px : 0px;
        height: root.height;
        border-radius: Metrics.radius-panel;
        border-width: 1px;
        border-color: root.active ? Tokens.accent : Tokens.border;
        background: touch.has-hover ? Tokens.panel-hover : Tokens.panel;
        animate y, background { duration: Motion.base; }

        CoverArt {
            x: root.inset;
            y: root.inset;
            width: root.width - 2 * root.inset;
            height: self.width;
            radius: 12px;
            track-id: root.card.track-id;
            gradient-index: root.card.gradient-index;
            drop-shadow-offset-y: Tokens.shadow-card.offset-y;
            drop-shadow-blur: Tokens.shadow-card.blur;
            drop-shadow-spread: Tokens.shadow-card.spread;
            drop-shadow-color: Tokens.shadow-card.color;
        }

        VerticalLayout {
            x: root.inset;
            y: root.width - root.inset + 12px;
            width: root.width - 2 * root.inset;
            height: self.preferred-height;
            spacing: 2px;
            Text {
                text: root.card.title;
                font-size: Typography.heading-sm;
                font-weight: Typography.bold;
                color: Tokens.text;
                horizontal-alignment: left;
                overflow: elide;
            }
            Text {
                text: root.card.subtitle;
                font-size: Typography.body;
                color: Tokens.text-muted;
                horizontal-alignment: left;
                overflow: elide;
            }
            if root.shows-detail: Text {
                text: root.card.detail;
                font-size: Typography.caption;
                color: Tokens.text-faint;
                horizontal-alignment: left;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
