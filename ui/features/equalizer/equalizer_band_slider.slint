import { Tokens, Fonts, Typography } from "../../tokens.slint";
import { SliderKeys } from "../../atoms/slider_keys.slint";

// One band of the equalizer: its gain, a column to drag (or to step with the
// arrow keys once it has the focus), and its frequency.
export component EqualizerBandSlider inherits VerticalLayout {
    in property <float> gain;
    in property <float> range: 12;
    in property <string> frequency-label;
    callback changed(gain: float);

    // 0 at the bottom of the column, 1 at the top.
    property <float> fraction: (root.gain + root.range) / (root.range * 2);
    // One step of the keys and of assistive technology, in dB: the half
    // decibel a band snaps to.
    property <float> step: 0.5;

    function move-to(gain: float) {
        root.changed(clamp(gain, -root.range, root.range));
    }

    spacing: 10px;

    Text {
        text: (root.gain > 0 ? "+" : "") + root.gain;
        font-family: Fonts.mono;
        font-size: Typography.label;
        font-weight: Typography.bold;
        color: root.gain > 0 ? Tokens.lime : root.gain < 0 ? Tokens.ember : Tokens.text-muted;
        horizontal-alignment: center;
    }

    HorizontalLayout {
        alignment: center;
        column := Rectangle {
            width: 34px;
            height: 190px;
            border-radius: self.width / 2;
            background: Tokens.well-deep;
            clip: true;
            accessible-role: slider;
            accessible-label: root.frequency-label;
            accessible-value-minimum: -root.range;
            accessible-value-maximum: root.range;
            accessible-value-step: root.step;
            accessible-value: root.gain;
            accessible-action-increment => { root.move-to(root.gain + root.step); }
            accessible-action-decrement => { root.move-to(root.gain - root.step); }
            accessible-action-set-value(value) => {
                if value.is-float() {
                    root.move-to(value.to-float());
                }
            }

            keys := SliderKeys {
                increment => { root.move-to(root.gain + root.step); }
                decrement => { root.move-to(root.gain - root.step); }
                to-minimum => { root.move-to(-root.range); }
                to-maximum => { root.move-to(root.range); }
            }

            Rectangle {
                y: root.gain >= 0 ? column.height * (1 - root.fraction) : column.height / 2;
                height: abs(root.fraction - 0.5) * column.height;
                background: Tokens.equalizer-band-fill;
            }

            Rectangle {
                width: 2px;
                height: 1px;
                background: Tokens.rail;
            }

            Rectangle {
                y: column.height * (1 - root.fraction) - self.height / 2;
                width: 26px;
                height: 12px;
                border-radius: self.height / 2;
                border-width: 2px;
                border-color: Tokens.equalizer-handle-ring;
                background: Tokens.text;
            }

            if keys.has-focus: Rectangle {
                border-radius: self.width / 2;
                border-width: 1px;
                border-color: Tokens.accent-ring;
            }

            touch := TouchArea {
                mouse-cursor: row-resize;

                function follow() {
                    root.changed((1 - max(0, min(1, self.mouse-y / self.height))) * root.range * 2 - root.range);
                }

                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        keys.focus();
                        self.follow();
                    }
                }
                moved => {
                    if self.pressed {
                        self.follow();
                    }
                }
            }
        }
    }

    Text {
        text: root.frequency-label;
        font-family: Fonts.mono;
        font-size: Typography.label;
        color: Tokens.text-muted;
        horizontal-alignment: center;
    }
}
