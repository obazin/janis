import { Tokens, Motion } from "../tokens.slint";

// A vertically scrolling box with the thin accent scroll bar.
//
// Long lists draw only the rows in view: a list of fixed-height rows asks
// `first-row` and `row-count` which rows those are, and places each at
// `index * row-height` inside a `content-height` of all of them.
export component ScrollArea inherits Rectangle {
    in property <length> content-height;
    out property <length> scroll-offset: -flickable.content-y;
    out property <length> content-width: flickable.width;

    property <length> furthest: max(0px, root.content-height - root.height);
    property <bool> scrollable: root.furthest > 0;
    // Whether the last move asked for was a glide. The wheel moves the page
    // itself and is never animated.
    property <bool> gliding;

    public pure function first-row(row-height: length) -> int {
        max(0, floor(root.scroll-offset / row-height))
    }

    public pure function row-count(row-height: length) -> int {
        ceil(root.height / row-height) + 1
    }

    // Jumps to `offset`, as the scroll bar does under the pointer.
    public function scroll-to(offset: length) {
        root.gliding = false;
        flickable.content-y = -max(0px, min(root.furthest, offset));
    }

    // Eases to `offset`: for a move the page makes on its own, so the eye can
    // follow where the content went. The page may be shorter than `offset`
    // while it glides, when what will fill it is still opening: the caller
    // keeps `offset` within where the content will end.
    public function glide-to(offset: length) {
        root.gliding = true;
        flickable.content-y = -max(0px, offset);
    }

    flickable := Flickable {
        // The scroll bar's gutter is always kept, so content does not shift
        // when a list grows long enough to scroll.
        width: root.width - 12px;
        x: 0;
        interactive: false;
        content-width: self.width;
        content-height: max(root.content-height, self.height);
        animate content-y {
            duration: root.gliding ? Motion.glide : 0ms;
            easing: ease-out;
        }
        @children
    }

    if root.scrollable: Rectangle {
        x: root.width - 8px;
        width: 8px;
        Rectangle {
            y: root.scroll-offset / root.content-height * root.height;
            height: max(24px, root.height / root.content-height * root.height);
            border-radius: parent.width / 2;
            background: bar.has-hover || bar.pressed ? Tokens.scrollbar-hover : Tokens.scrollbar;
        }

        bar := TouchArea {
            function follow() {
                root.scroll-to(self.mouse-y / root.height * root.content-height - root.height / 2);
            }

            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    self.follow();
                }
            }
            moved => {
                if self.pressed {
                    self.follow();
                }
            }
        }
    }
}
