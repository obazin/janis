import { Tokens, Fonts, Typography } from "../tokens.slint";
import { Icons } from "../icons.slint";
import { Strings } from "strings.slint";
import { Glyph } from "../atoms/glyph.slint";
import { PrimaryButton, PrimaryButtonVariant } from "../atoms/primary_button.slint";

// The Spotify connection, announced but not built yet: the button only says so.
export component SpotifyScreen inherits Rectangle {
    property <bool> note-shown;

    VerticalLayout {
        alignment: start;
        padding-top: 76px;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: 560px;
                spacing: 0px;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 80px;
                        height: 80px;
                        border-radius: 40px;
                        background: Tokens.spotify;
                        drop-shadow-offset-y: Tokens.shadow-card.offset-y;
                        drop-shadow-blur: Tokens.shadow-card.blur;
                        drop-shadow-spread: Tokens.shadow-card.spread;
                        drop-shadow-color: Tokens.shadow-card.color;
                        Glyph {
                            width: 44px;
                            height: 44px;
                            icon: Icons.spotify-full;
                            tint: Tokens.on-accent;
                        }
                    }
                }
                Rectangle {
                    height: 24px;
                }
                Text {
                    text: Strings.spotify-title;
                    font-family: Fonts.display;
                    font-weight: Typography.black;
                    font-size: Typography.display-sm;
                    color: Tokens.text;
                    horizontal-alignment: center;
                }
                Rectangle {
                    height: 12px;
                }
                Text {
                    text: Strings.spotify-desc;
                    font-size: Typography.heading-sm;
                    color: Tokens.text-soft;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 26px;
                }
                HorizontalLayout {
                    alignment: center;
                    PrimaryButton {
                        label: Strings.spotify-cta;
                        variant: PrimaryButtonVariant.spotify;
                        clicked => { root.note-shown = true; }
                    }
                }
                if root.note-shown: Text {
                    height: self.preferred-height + 16px;
                    text: Strings.spotify-coming-soon;
                    font-size: Typography.body-em;
                    color: Tokens.warning;
                    horizontal-alignment: center;
                    vertical-alignment: bottom;
                }
                Rectangle {
                    height: 34px;
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 26px;
                    for feature in [Strings.spotify-feature-playlists, Strings.spotify-feature-search, Strings.spotify-feature-eq]: Text {
                        text: "✓ " + feature;
                        font-size: Typography.body;
                        color: Tokens.text-muted;
                    }
                }
            }
        }
    }
}
