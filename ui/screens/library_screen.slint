import { Tokens, Accent } from "../tokens.slint";
import { Icons } from "../icons.slint";
import { Strings } from "strings.slint";
import { Chip } from "../atoms/chip.slint";
import { EmptyState } from "../atoms/empty_state.slint";
import { GhostButton } from "../atoms/ghost_button.slint";
import { PrimaryButton } from "../atoms/primary_button.slint";
import { SectionLabel } from "../atoms/section_label.slint";
import { ScreenHeader } from "../molecules/screen_header.slint";
import { ScrollArea } from "../molecules/scroll_area.slint";
import { Library } from "../features/library/library.slint";
import { CoverList } from "../features/library/covers.slint";
import { CardGrid } from "../features/library/card_grid.slint";
import { TrackList } from "../features/library/track_list.slint";

// The library: the playlists, by group, and the albums and artists as grids
// that open in place, every song as one list, the starred songs as another,
// and what was added last.
export component LibraryScreen inherits Rectangle {
    property <length> side: 44px;
    property <length> section-gap: 36px;
    property <length> content-width: page.content-width - root.side - 32px;
    property <bool> grid-tab: Library.tab == "albums" || Library.tab == "artists";
    property <bool> list-tab: Library.tab == "songs" || Library.tab == "favourites";
    property <bool> playlists-tab: Library.tab == "playlists";
    property <bool> shows-recent: !Library.empty && root.grid-tab && !Library.selection-present && Library.recent.length > 0;

    page := ScrollArea {
        content-height: recent.y + (root.shows-recent ? recent.height : 0px) + 40px;

        top := VerticalLayout {
            x: root.side;
            y: 0;
            width: root.content-width;
            height: self.preferred-height;
            padding-top: 36px;
            spacing: 24px;

            ScreenHeader {
                eyebrow: Strings.library-eyebrow;
                tone: Accent.violet;
                title: Strings.library-title;
                PrimaryButton {
                    label: Strings.library-add-music;
                    icon: Icons.plus;
                    clicked => { Library.add-music(); }
                }
            }

            if Library.empty: EmptyState {
                icon: Icons.library;
                title: Strings.library-empty-title;
                description: Strings.library-empty-desc;
                action-label: Strings.local-add-folder;
                action-icon: Icons.plus;
                action-clicked => { Library.add-folder(); }
            }

            if !Library.empty: HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Chip {
                    label: Strings.library-tab-playlists;
                    active: Library.tab == "playlists";
                    clicked => { Library.tab-selected("playlists"); }
                }
                Chip {
                    label: Strings.library-tab-artists;
                    active: Library.tab == "artists";
                    clicked => { Library.tab-selected("artists"); }
                }
                Chip {
                    label: Strings.library-tab-albums;
                    active: Library.tab == "albums";
                    clicked => { Library.tab-selected("albums"); }
                }
                Chip {
                    label: Strings.library-tab-songs;
                    active: Library.tab == "songs";
                    clicked => { Library.tab-selected("songs"); }
                }
                Chip {
                    label: Strings.library-tab-favourites;
                    active: Library.tab == "favourites";
                    clicked => { Library.tab-selected("favourites"); }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                if root.playlists-tab && !Library.playlists-empty: GhostButton {
                    icon: Icons.pencil;
                    label: Strings.library-playlists-manage;
                    clicked => { Library.manager-opened(); }
                }
            }

            if !Library.empty && root.playlists-tab && Library.playlists-empty: EmptyState {
                icon: Icons.playlist;
                title: Strings.library-playlists-empty-title;
                description: Strings.library-playlists-empty-desc;
            }

            if !Library.empty && Library.tab == "favourites" && Library.favourites-empty: EmptyState {
                icon: Icons.star;
                title: Strings.library-favourites-empty-title;
                description: Strings.library-favourites-empty-desc;
            }
        }

        body := Rectangle {
            x: root.side;
            y: top.height + 24px;
            width: root.content-width;
            height: Library.empty ? 0px : root.grid-tab ? grid.height : root.list-tab ? songs.height : root.playlists-tab ? playlist-column.height : 0px;

            grid := CardGrid {
                y: 0;
                visible: !Library.empty && root.grid-tab;
                cards: Library.tab == "albums" ? Library.albums : Library.artists;
                // Only the list on show reports what it draws.
                cover-list: !root.grid-tab ? CoverList.none : Library.tab == "albums" ? CoverList.albums : CoverList.artists;
                shows-detail: Library.tab == "albums";
                view-top: page.scroll-offset - body.y;
                view-height: page.height;
                card-clicked(index) => {
                    if Library.tab == "albums" {
                        Library.album-clicked(index);
                    } else {
                        Library.artist-clicked(index);
                    }
                }
                // The opened card's line glides to the top of the page, as
                // far as the page will reach once its panel has unfolded.
                opened(line-top, settled-height) => {
                    page.glide-to(min(body.y + line-top, page.content-height - self.height + settled-height - page.height));
                }
            }

            // The playlists: a grid under each group's heading, then those in
            // no group. Each grid draws only its lines in view.
            playlist-column := VerticalLayout {
                y: 0;
                width: parent.width;
                height: self.preferred-height;
                visible: !Library.empty && root.playlists-tab;
                // Each grid ends with the gap under its last line.
                spacing: root.section-gap - 20px;

                for section[section-index] in Library.playlist-sections: section-box := VerticalLayout {
                    spacing: 14px;
                    if section.heading != "": SectionLabel {
                        label: section.heading;
                    }
                    section-grid := CardGrid {
                        cards: section.cards;
                        shows-detail: true;
                        selection-index: section.selection-index;
                        folding-index: section.folding-index;
                        cover-list: CoverList.none;
                        view-top: page.scroll-offset - body.y - section-box.y - self.y;
                        view-height: page.height;
                        card-clicked(index) => { Library.playlist-clicked(section-index, index); }
                        opened(line-top, settled-height) => {
                            page.glide-to(min(body.y + section-box.y + self.y + line-top, page.content-height - self.height + settled-height - page.height));
                        }
                    }
                }
            }

            // All the songs, or the starred ones: one list, whichever tab is open.
            songs := TrackList {
                y: 0;
                visible: !Library.empty && root.list-tab;
                tracks: Library.tab == "favourites" ? Library.favourites : Library.songs;
                cover-list: Library.tab == "songs" ? CoverList.songs : Library.tab == "favourites" ? CoverList.favourites : CoverList.none;
                view-top: page.scroll-offset - body.y;
                view-height: page.height;
                clicked(index) => {
                    if Library.tab == "favourites" {
                        Library.favourite-clicked(index);
                    } else {
                        Library.song-clicked(index);
                    }
                }
            }
        }

        recent := VerticalLayout {
            x: root.side;
            y: body.y + body.height + (body.height > 0 ? root.section-gap : 0px);
            width: root.content-width;
            height: self.preferred-height;
            visible: root.shows-recent;
            spacing: 8px;
            SectionLabel {
                label: Strings.library-recently-added;
            }
            recent-list := TrackList {
                tracks: Library.recent;
                // Short enough to draw whole.
                view-top: 0px;
                view-height: self.height;
                clicked(index) => { Library.recent-clicked(index); }
            }
        }
    }
}
