// The application window: the title bar, the sidebar beside the open screen,
// the mini player, and what floats above them.

import { Tokens, Fonts, Typography } from "tokens.slint";
import { Icons } from "icons.slint";
import { Strings } from "strings.slint";
import { SidebarNav } from "organisms/sidebar_nav.slint";
import { Toaster } from "organisms/toaster.slint";
import { Shell } from "shell.slint";
import { Player } from "features/player/player.slint";
import { MiniPlayer } from "features/player/mini_player.slint";
import { Equalizer } from "features/equalizer/equalizer.slint";
import { EqualizerOverlay } from "features/equalizer/equalizer_overlay.slint";
import { Covers } from "features/library/covers.slint";
import { AppTitlebar } from "screens/app_titlebar.slint";
import { NowPlayingScreen } from "screens/now_playing_screen.slint";
import { LibraryScreen } from "screens/library_screen.slint";
import { LocalFilesScreen } from "screens/local_files_screen.slint";
import { RadioScreen } from "screens/radio_screen.slint";
import { DiscoverScreen } from "screens/discover_screen.slint";
import { SpotifyScreen } from "screens/spotify_screen.slint";
import { SettingsScreen } from "screens/settings_screen.slint";
import { Settings } from "features/settings/settings.slint";
import { Radio } from "features/radio/radio.slint";
import { Library } from "features/library/library.slint";

export { Strings, Shell, Player, Covers, Equalizer, Library, Radio, Settings, Tokens }

export component AppWindow inherits Window {
    title: "Janis";
    icon: @image-url("../packaging/icons/128x128@2x.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1024px;
    min-height: 680px;
    background: Tokens.window;
    default-font-family: Fonts.sans;
    default-font-size: Typography.body;

    VerticalLayout {
        AppTitlebar { }

        HorizontalLayout {
            vertical-stretch: 1;
            SidebarNav {
                sections: [
                    {
                        label: Strings.nav-section-playing,
                        items: [{ id: "now-playing", label: Strings.nav-now-playing, icon: Icons.now-playing }]
                    },
                    {
                        label: Strings.nav-section-library,
                        items: [
                            { id: "library", label: Strings.nav-library, icon: Icons.library },
                            { id: "discover", label: Strings.nav-discover, icon: Icons.discover }
                        ]
                    },
                    {
                        label: Strings.nav-section-sources,
                        items: [
                            { id: "radio", label: Strings.nav-radio, icon: Icons.radio },
                            { id: "local", label: Strings.nav-local, icon: Icons.local-files },
                            { id: "spotify", label: Strings.nav-spotify, icon: Icons.spotify }
                        ]
                    }
                ];
                footer-item: { id: "settings", label: Strings.nav-settings, icon: Icons.equalizer };
                active-id: Shell.screen;
                item-clicked(id) => { Shell.screen = id; }
            }

            Rectangle {
                horizontal-stretch: 1;
                if Shell.screen == "now-playing": NowPlayingScreen {
                    add-music => { Library.add-music(); }
                }
                if Shell.screen == "library": LibraryScreen { }
                if Shell.screen == "local": LocalFilesScreen { }
                if Shell.screen == "radio": RadioScreen { }
                if Shell.screen == "discover": DiscoverScreen { }
                if Shell.screen == "spotify": SpotifyScreen { }
                if Shell.screen == "settings": SettingsScreen { }
            }
        }

        MiniPlayer { }
    }

    if Shell.equalizer-open: EqualizerOverlay {
        init => { self.take-focus(); }
    }

    Toaster {
        x: root.width - self.width - 24px;
        y: root.height - self.height - 96px;
        height: self.preferred-height;
        items: Shell.toasts;
        dismiss-label: Strings.notification-dismiss;
        dismissed(id) => { Shell.toast-dismissed(id); }
    }
}
